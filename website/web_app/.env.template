# Gene Pathway Analysis Web Application - Environment Configuration
# ==================================================================
# Copy this file to .env and fill in your API keys
# The server will automatically load these environment variables

# OpenAI API Key (required for GPT-5 pathway ranking)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# NCBI Entrez Email (required for PubMed literature search)
# This is your email address for NCBI API access
ENTREZ_EMAIL=your-email@example.com

# Optional: GPT Model Selection
# Default is gpt-5.1 (can also use gpt-4o-mini for faster/cheaper testing)
GPT_MODEL=gpt-5.1

# Internal team authentication (Amazon Cognito)
# Keep AUTH_ENABLED=true in AWS. Use false only for local development.
AUTH_ENABLED=true
ACCESS_MODE=team
FLASK_SECRET_KEY=replace-with-a-long-random-secret
APP_BASE_URL=https://your-elastic-beanstalk-or-custom-domain

# Optional completion emails through Amazon SES. The sender identity must be
# verified in the same SES region before enabling this setting.
ANALYSIS_EMAIL_NOTIFICATIONS=false
SES_REGION=us-east-1
SES_FROM_EMAIL=notifications@your-domain.example

# Cognito user pool and confidential web app client
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_EXAMPLE
COGNITO_CLIENT_ID=replace-with-cognito-app-client-id
COGNITO_CLIENT_SECRET=replace-with-cognito-app-client-secret
COGNITO_DOMAIN=https://your-domain-prefix.auth.us-east-1.amazoncognito.com

# Only these Cognito-authenticated email addresses may enter the application.
# Add the full bingxin email here during AWS configuration.
ALLOWED_EMAILS=bingxin@example.com

# Server-side public-beta limits. Keep ACCESS_MODE=team until public launch.
QUOTA_ENABLED=true
QUOTA_BACKEND=dynamodb
QUOTA_TABLE_NAME=GenePathwayAI-Usage
USER_DAILY_JOB_LIMIT=3
GLOBAL_DAILY_JOB_LIMIT=30
MAX_CONCURRENT_JOBS=1

# Fingerprinted WhiteNoise assets are immutable and receive its long-lived cache.
# This value is the fallback lifetime for any future non-immutable static asset.
# HTML is always revalidated and points to a new hash after each asset change.
STATIC_CACHE_MAX_AGE=31536000

# Optional. Leave blank for the same-origin web application.
CORS_ALLOWED_ORIGINS=
